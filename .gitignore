
# Byte-compiled / optimized / DLL files
**/*.py[cod]
**/*.pyo
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/


**/*.py[cod]
**/*$py.class
**/*.so

# Virtual environments
**/.venv/
**/.env
**/*.env.local
**/*.env.*.local

# PDF files to ignore in any subfolder
**/*.pdf
**/*.docx
**/*.xlsx
**/*assignment*
**/*.pkl
**/PLAN.md


# Common temporary and OS files
**/*.log
**/*.tmp
**/*~
**/.DS_Store
**/Thumbs.db


**/ollama_data/
**/chroma_db/

**/node_modules/
**/frontend/node_modules/
**/dist/
**/vite/

**/.idea/
**/.vscode/
**/*.swp


# Private keys and certificates (e.g. generated by containers)
**/id_rsa
**/id_rsa.pub
**/id_ed25519
**/id_ed25519.pub
**/*.pem
**/*.key
**/*.cert

# Heavy Local Models & Runtime Data
**/ollama_data/
*/ollama_data/
**/*.bin
**/*.safetensors
**/*.gguf

# ChromaDB vector store data. Re-created automatically upon document ingestion.
**/chroma_db/
**/backend/chroma_db/
**/*.sqlite3
**/*.sqlite3-journal

# Redis persistence
**/redis_data/
**/dump.rdb

# Production build output. Rebuilt cleanly via `npm run build` or Docker.
**/dist/
**/frontend/dist/
**/build/
**/.npm/

# Package manager logs & caches
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/.eslintcache
**/*.tsbuildinfo


# Test & coverage artifacts
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/.tox/
**/.nox/
**/.mypy_cache/
**/.ruff_cache/


# System, Editor & IDE Files
**/.DS_Store
**/.DS_Store?
**/._*
**/.Spotlight-V100
**/.Trashes
**/ehthumbs.db
**/Thumbs.db

# IDE / Editor configurations
**/.idea/
**/.vscode/
**/*.swp
**/*.swo
**/*~
**/*.bak
**/*.tmp

# Logs & Debug Traces
**/*.log
**/logs/
