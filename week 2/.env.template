# Copy this file to .env and fill the values before running

# PostgreSQL credentials
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=classicmodels
POSTGRES_PORT=5432

# When running with Docker Compose, the DB host inside the network is `db`.
# For local runs (Postgres on your machine), set this to `localhost`.
POSTGRES_HOST=localhost
