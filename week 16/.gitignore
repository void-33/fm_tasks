# ==============================================================================
# .gitignore — Week 16 Task 3 Agent Assignment Submission
# ==============================================================================

# ── 1. Secrets, Environment Files & Keys ──────────────────────────────────────
# Never commit live API keys or private credentials to source control.
.env
*.env
*.env.local
*.env.*.local
!*.env.template

# Private keys and certificates (e.g. generated by containers)
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.pem
*.key
*.cert

# ── 2. Heavy Local Models & Runtime Data (Do Not Submit) ──────────────────────
# Ollama models & weights (~380MB+). Re-pulled automatically by Docker on startup.
ollama_data/
*/ollama_data/
*.bin
*.safetensors
*.gguf

# ChromaDB vector store data. Re-created automatically upon document ingestion.
chroma_db/
backend/chroma_db/
*.sqlite3
*.sqlite3-journal

# Redis persistence
redis_data/
dump.rdb

# ── 3. Node & Frontend Build Artifacts ────────────────────────────────────────
# Dependencies (~50MB+). Restored via `npm install` inside Docker or locally.
node_modules/
frontend/node_modules/

# Production build output. Rebuilt cleanly via `npm run build` or Docker.
dist/
frontend/dist/
build/
.npm/

# Package manager logs & caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
*.tsbuildinfo

# ── 4. Python Bytecode, Caches & Virtual Environments ─────────────────────────
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so

# Test & coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── 5. System, Editor & IDE Files ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE / Editor configurations
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.tmp

# ── 6. Logs & Debug Traces ───────────────────────────────────────────────────
*.log
logs/
