# ── LLM Configuration ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_API_BASE=http://ollama:11434/v1
OLLAMA_MODEL=qwen2.5:0.5b

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
CACHE_TTL=3600

RATE_LIMIT=60/minute
CHROMA_DB_DIR=./chroma_db

# ── Agent Limits (Bounded Verification Loop) ──────────────────────────────────
AGENT_MAX_STEPS=6
AGENT_MAX_SEARCHES=4
AGENT_TOP_K_MAX=5
AGENT_MAX_EVIDENCE_ITEMS=12
AGENT_MAX_EVIDENCE_CHARS=12000
AGENT_MAX_QUERY_CHARS=500
AGENT_TOOL_TIMEOUT_SECONDS=10.0
AGENT_REQUEST_TIMEOUT_SECONDS=60.0
AGENT_MAX_INVALID_ACTION_REPAIRS=1

